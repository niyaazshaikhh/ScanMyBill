NEXT_PUBLIC_APP_URL=http://localhost:3000
# Use absolute URL for split frontend/backend domains.
# Use `/api/v1` when both are behind the same domain and reverse proxy.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SESSION_IDLE_TIMEOUT_MINUTES=30
# Keep the populated frontend/.env file local-only and out of git.

# Optional legacy fallback respected in useAuthGuard.
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=30

NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
