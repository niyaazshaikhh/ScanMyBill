# Root environment variables for docker compose.
# Copy this file to `.env` and adjust values for your environment.

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=scanmybill

# Backend runtime profile
ENVIRONMENT=development
DEBUG=false
ENABLE_DOCS=true
COOKIE_SECURE=false
ENFORCE_HTTPS=false
SEED_DEFAULT_ADMIN=false
EXPOSE_PASSWORD_RESET_TOKEN=false
UPLOADS_DIR=uploads

# CORS and host controls
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,backend

# Service ports and image tags
BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_IMAGE=scanmybill/backend:latest
FRONTEND_IMAGE=scanmybill/frontend:latest

# Frontend public variables (also used as Docker build args)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SESSION_IDLE_TIMEOUT_MINUTES=30
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
