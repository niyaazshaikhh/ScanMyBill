# Root environment variables for docker compose.
# Copy this file to `.env` and adjust values for your environment.

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=scanmybill
# Optional managed database URL for cloud providers.
# If set, backend uses this instead of POSTGRES_*.
DATABASE_URL_OVERRIDE=

# Backend runtime profile
ENVIRONMENT=development
DEBUG=false
ENABLE_DOCS=true
COOKIE_SECURE=false
ENFORCE_HTTPS=false
SEED_DEFAULT_ADMIN=false
EXPOSE_PASSWORD_RESET_TOKEN=false
UPLOADS_DIR=uploads

# CORS and host controls
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,backend
# Production example:
# CORS_ORIGINS=https://app.yourdomain.com
# TRUSTED_HOSTS=api.yourdomain.com,app.yourdomain.com

# Service ports and image tags
BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_INTERNAL_PORT=8000
FRONTEND_INTERNAL_PORT=3000
BACKEND_IMAGE=scanmybill/backend:latest
FRONTEND_IMAGE=scanmybill/frontend:latest

# Frontend public variables (also used as Docker build args)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Use absolute URL for separate frontend/backend domains.
# Use `/api/v1` when frontend and backend are served under one domain with reverse proxy.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Production CI/CD examples:
# NEXT_PUBLIC_APP_URL=https://app.yourdomain.com
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
# NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SESSION_IDLE_TIMEOUT_MINUTES=30
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
