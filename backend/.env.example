APP_NAME=ScanMyBill API
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=false
ENABLE_DOCS=true
LOG_LEVEL=INFO
TRUST_PROXY_HEADERS=true
ENFORCE_HTTPS=false
TRUSTED_HOSTS=localhost,127.0.0.1,*.localhost

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scanmybill
DATABASE_URL_OVERRIDE=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_INACTIVITY_TIMEOUT_MINUTES=30
ACCESS_TOKEN_REFRESH_THRESHOLD_MINUTES=3
JWT_ALGORITHM=HS256
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
EXPOSE_PASSWORD_RESET_TOKEN=true
SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_USER_ID=admin_niyaz7
DEFAULT_ADMIN_EMAIL=admin@scanmybill.xyz
DEFAULT_ADMIN_PASSWORD="#AdminNiyaz7"
DEFAULT_ADMIN_FULL_NAME=Admin User
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=ScanMyBill
SMTP_USE_TLS=true

CORS_ORIGINS=http://localhost:3000,https://scanmybill.xyz
SECURITY_CSP=default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
HSTS_MAX_AGE_SECONDS=31536000
REQUEST_MAX_MB=25
ENABLE_RATE_LIMITING=true
RATE_LIMIT_DEFAULT_PER_MINUTE=240
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_INVOICE_PDF_PER_MINUTE=60

STORAGE_BACKEND=local
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=10
SERVE_PUBLIC_UPLOADS=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=

GOOGLE_CLIENT_ID=
# Optional: comma-separated list if you support multiple Google OAuth client IDs.
GOOGLE_CLIENT_IDS=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
# Optional: comma-separated list to allow multiple selectable plans in frontend.
RAZORPAY_PLAN_IDS=
# Required to validate Razorpay webhook signatures for subscription status updates.
RAZORPAY_WEBHOOK_SECRET=


