# Backend runtime environment.
# Copy this file to backend/.env and fill secrets before deployment.

# App
APP_NAME=ScanMyBill API
API_V1_PREFIX=/api/v1
PORT=8000
ENVIRONMENT=development
DEBUG=false
ENABLE_DOCS=true
LOG_LEVEL=INFO
TRUST_PROXY_HEADERS=true
ENFORCE_HTTPS=false
TRUSTED_HOSTS=localhost,127.0.0.1,*.localhost,backend

# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=scanmybill
DATABASE_URL_OVERRIDE=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000
HEALTHCHECK_DB_TIMEOUT_SECONDS=3

# Authentication and session
SECRET_KEY=change-this-in-production-with-32-plus-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_INACTIVITY_TIMEOUT_MINUTES=30
ACCESS_TOKEN_REFRESH_THRESHOLD_MINUTES=3
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
JWT_ALGORITHM=HS256
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
EXPOSE_PASSWORD_RESET_TOKEN=false

# API security and rate limiting
CORS_ORIGINS=http://localhost:3000
SECURITY_CSP=default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
HSTS_MAX_AGE_SECONDS=31536000
REQUEST_MAX_MB=25
ENABLE_RATE_LIMITING=true
RATE_LIMIT_DEFAULT_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_INVOICE_PDF_PER_MINUTE=60

# Storage
STORAGE_BACKEND=local
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=10
SERVE_PUBLIC_UPLOADS=false

# Frontend links
FRONTEND_RESET_PASSWORD_URL=https://app.scanmybill.xyz/reset-password
NEWSLETTER_UNSUBSCRIBE_BASE_URL=https://api.scanmybill.xyz/api/v1/newsletter/unsubscribe
NEWSLETTER_LOGO_URL=https://app.scanmybill.xyz/icons/icon-512.png
NEWSLETTER_BRAND_NAME=ScanMyBill by NIYAZ
NEWSLETTER_BRAND_COLOR=#d85b1b

# AWS S3 (when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# AI providers
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=
AZURE_KEY_VAULT_URI=

# OAuth
GOOGLE_CLIENT_ID=
# Optional comma-separated list if multiple Google client IDs are accepted.
GOOGLE_CLIENT_IDS=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
# Optional comma-separated list to expose multiple plans.
RAZORPAY_PLAN_IDS=
# Required to verify webhook signatures.
RAZORPAY_WEBHOOK_SECRET=

# Default admin bootstrap (keep false in production)
SEED_DEFAULT_ADMIN=false
DEFAULT_ADMIN_USER_ID=admin_niyaz7
DEFAULT_ADMIN_EMAIL=admin@scanmybill.xyz
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_FULL_NAME=Admin User

# SMTP
SMTP_HOST=
SMTP_PORT=587
# Optional alias supported by fallback sender utility.
SMTP_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=ScanMyBill
SMTP_USE_TLS=true
