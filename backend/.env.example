APP_NAME=ScanMyBill.in API
API_V1_PREFIX=/api/v1

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scanmybill

SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_ALGORITHM=HS256

CORS_ORIGINS=http://localhost:3000

STORAGE_BACKEND=local
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

GOOGLE_CLIENT_ID=
# Optional: comma-separated list if you support multiple Google OAuth client IDs.
GOOGLE_CLIENT_IDS=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
# Optional: comma-separated list to allow multiple selectable plans in frontend.
RAZORPAY_PLAN_IDS=
